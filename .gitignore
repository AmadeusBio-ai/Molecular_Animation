# Build products and large media: rebuilt from scripts, or (for the case study) fetched from the GitHub
# release with `python pipeline.py fetch <shot>`.
renders/
delivery/
*.blend
*.blend1
*.blend@

# Reference clips and images are local working material: keep them out of git unless you hold the rights.
references/*
!references/README.md

# Python and OS clutter
__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store
Thumbs.db
desktop.ini

# Local Claude Code settings
.claude/settings.local.json

# AlphaFold Server output: subject to its Output Terms of Use and not redistributed here; the rendered films carry
# the notice (projects/art-rna/sources/README.md, projects/website/record.md). The p53 job request stays.
projects/art-rna/af3/
projects/website/af3/*
!projects/website/af3/p53-tetramer-p21.json
# The owner's hand-over folder for the ART project (brief, job package, AlphaFold results). What the project
# uses is copied into projects/art-rna/sources/.
CRISPR-Like/
